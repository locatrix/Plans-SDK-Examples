@page
@model esapi_browser.Pages.PartnerModel
@{
    ViewData["Title"] = "Clients";
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Partners</a></li>
    <li class="breadcrumb-item active" aria-current="page">Clients</li>
  </ol>
</nav>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <h4>Clients</h4>
            @if (Model.Clients == null)
            {
                <p><em>Loading...</em></p>
            }
            else if (Model.ErrorMessage != null)
            {
                <p class="alert alert-danger">@Model.ErrorMessage</p>
            }
            else
            {
                <ul class="list-group">
                @foreach (var client in Model.Clients)
                {
                    <li class="list-group-item">
                        <a href="/client?ptnr=@Model.PartnerCode&clnt=@client.Code">@client.Name</a>
                    </li>
                }
                </ul>
            }
        </div>
    </div>
</div>


