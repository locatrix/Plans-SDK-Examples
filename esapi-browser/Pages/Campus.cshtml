@page
@model esapi_browser.Pages.CampusModel
@{
    ViewData["Title"] = "Buildings";
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Partners</a></li>
    <li class="breadcrumb-item"><a href="/partner?ptnr=@Model.PartnerCode">Clients</a></li>
    <li class="breadcrumb-item"><a href="/client?ptnr=@Model.PartnerCode&clnt=@Model.ClientCode">Campuses</a></li>
    <li class="breadcrumb-item active" aria-current="page">Buildings</li>
  </ol>
</nav>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <h4>Buildings</h4>
            @if (Model.Buildings == null)
            {
                <p><em>Loading...</em></p>
            }
            else if (Model.ErrorMessage != null)
            {
                <p class="alert alert-danger">@Model.ErrorMessage</p>
            }
            else
            {
                <ul class="list-group">
                @foreach (var building in Model.Buildings)
                {
                    <li class="list-group-item">
                        <a href="/building?ptnr=@Model.PartnerCode&clnt=@Model.ClientCode&camp=@Model.CampusCode&bld=@building.Code">@building.Name</a>
                    </li>
                }
                </ul>
            }
        </div>
    </div>
</div>


