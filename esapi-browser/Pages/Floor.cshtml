@page
@model esapi_browser.Pages.FloorModel
@{
    ViewData["Title"] = "Floor Details";
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Partners</a></li>
    <li class="breadcrumb-item"><a href="/partner?ptnr=@Model.PartnerCode">Clients</a></li>
    <li class="breadcrumb-item"><a href="/client?ptnr=@Model.PartnerCode&clnt=@Model.ClientCode">Campuses</a></li>
    <li class="breadcrumb-item"><a href="/campus?ptnr=@Model.PartnerCode&clnt=@Model.ClientCode&camp=@Model.CampusCode">Buildings</a></li>
    <li class="breadcrumb-item"><a href="/building?ptnr=@Model.PartnerCode&clnt=@Model.ClientCode&camp=@Model.CampusCode&bld=@Model.BuildingCode">Floors</a></li>
    <li class="breadcrumb-item active" aria-current="page">Floor Details</li>
  </ol>
</nav>

<div class="container">
    <h4>Embed API Sampler</h4>
    @if (Model.ErrorMessage != null)
    {
        <p class="alert alert-danger">@Model.ErrorMessage</p>
    }
    else if (string.IsNullOrEmpty(Model.EmbedURL))
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <iframe height="500px" width="100%" src="@Model.EmbedURL"></iframe>
    }
</div>
